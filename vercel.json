{
  "functions": {
    "api/run.py": {
      "maxDuration": 60,
      "excludeFiles": "{project_popups/**,Project_Background/**,GoT_LoR/**,projects/**,js/**,*.html,*.jpg,*.png,unpublished.jpg,Party_Seating/party_seating.html,Party_Seating/seating_data.js,Party_Seating/server.py,Party_Seating/config*.js,Party_Seating/api/**}"
    }
  },
  "rewrites": [
    { "source": "/api/defaults", "destination": "/api/run.py" },
    { "source": "/api/config", "destination": "/api/run.py" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type" }
      ]
    }
  ],
  "env": {
    "SOLVER_MAX_SECONDS": "10"
  }
}
